<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    >

    <title>
      <%= @goal.title %>を<%= @achievement_count %>回達成しました | GrowLog
    </title>

    <meta
      property="og:title"
      content="<%= @goal.title %>を<%= @achievement_count %>回達成しました"
    >

    <meta
      property="og:description"
      content="GrowLogで目標を継続しています。"
    >

    <meta property="og:type" content="website">

    <meta
      property="og:url"
      content="<%= @share_url %>"
    >

    <meta
      property="og:image"
      content="<%= @ogp_image_url %>"
    >

    <meta
      property="og:image:width"
      content="1200"
    >

    <meta
      property="og:image:height"
      content="630"
    >

    <meta
      property="og:image:alt"
      content="GrowLogで「<%= @goal.title %>」を<%= @achievement_count %>回達成した記録"
    >

    <meta
      name="twitter:card"
      content="summary_large_image"
    >

    <meta
      name="twitter:title"
      content="<%= @goal.title %>を<%= @achievement_count %>回達成しました"
    >

    <meta
      name="twitter:description"
      content="GrowLogで目標を継続しています。"
    >

    <meta
      name="twitter:image"
      content="<%= @ogp_image_url %>"
    >

    <meta
      name="twitter:image:alt"
      content="GrowLogで「<%= @goal.title %>」を<%= @achievement_count %>回達成した記録"
    >

    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #dff0e7;
        color: #1e293b;
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      .share-card {
        width: min(90%, 640px);
        padding: 48px 32px;
        text-align: center;
        background: white;
        border-radius: 32px;
        box-shadow: 0 16px 40px rgb(15 23 42 / 10%);
      }

      .service-name {
        color: #15803d;
        font-size: 24px;
        font-weight: 700;
      }

      .goal-title {
        margin-top: 32px;
        font-size: 36px;
      }

      .achievement-count {
        margin-top: 32px;
        color: #15803d;
        font-size: 48px;
        font-weight: 700;
      }

      .description {
        margin-top: 24px;
        color: #64748b;
      }

      .app-link {
        display: inline-block;
        margin-top: 32px;
        padding: 16px 28px;
        border-radius: 16px;
        background: #16a34a;
        color: white;
        text-decoration: none;
        font-weight: 700;
      }
    </style>
  </head>

  <body>
    <%= yield %>
  </body>
</html>